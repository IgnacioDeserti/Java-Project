# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

DB_NAME=kanban
DB_USER=kanban
DB_PASSWORD=change-me

# Generate with: openssl rand -base64 48
JWT_SECRET=change-this-to-a-long-random-string-at-least-32-bytes

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# SMTP — used to send verification and password-reset emails. Works with Gmail directly:
# MAIL_HOST=smtp.gmail.com, MAIL_USERNAME=you@gmail.com, MAIL_PASSWORD=<a 16-char Gmail
# App Password — not your normal Gmail password; see README for how to generate one>.
# Leave MAIL_HOST empty to fall back to logging emails to the console (dev only).
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@example.com

# "Sign in with Google" — leave both blank to keep it off (the email/password flow still
# works either way). See README for how to create these in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public URL of the frontend, used to build links inside emails.
APP_BASE_URL=http://localhost:5173

# Set to false to allow login before the email is verified (dev/testing only).
REQUIRE_EMAIL_VERIFICATION=true
